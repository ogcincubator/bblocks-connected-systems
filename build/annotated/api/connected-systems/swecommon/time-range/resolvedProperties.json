{"defs":{},"properties":[{"path":["id"],"description":"The ID of the object, referenceable using a URI fragment","schema_type":"string","sources":["bblocks://ogc.api.connected-systems.swecommon.basic-types"]},{"path":["label"],"description":"Human readable label for the object","schema_type":"string","sources":["bblocks://ogc.api.connected-systems.swecommon.abstract-swe-identifiable"]},{"path":["description"],"description":"Human readable description of the object","schema_type":"string","sources":["bblocks://ogc.api.connected-systems.swecommon.abstract-swe-identifiable"]},{"path":["type"],"required":true,"schema_type":"string","const":"TimeRange","sources":["bblocks://ogc.api.connected-systems.swecommon.abstract-data-component","bblocks://ogc.api.connected-systems.swecommon.time-range"]},{"path":["updatable"],"description":"Specifies if the value of a data component can be updated externally (i.e., is variable)","schema_type":"boolean","sources":["bblocks://ogc.api.connected-systems.swecommon.abstract-data-component"]},{"path":["optional"],"description":"Specifies if the data for this component can be omitted in the datastream","schema_type":"boolean","sources":["bblocks://ogc.api.connected-systems.swecommon.abstract-data-component"]},{"path":["definition"],"description":"The definition of the property whose value is provided by this component (semantic link)","schema_type":"string","format":"uri","sources":["bblocks://ogc.api.connected-systems.swecommon.abstract-data-component"]},{"path":["referenceFrame"],"description":"Frame of reference (usually temporal or spatial) with respect to which the value of the component is expressed. A reference frame anchors a value to a real world datum.","schema_type":"string","format":"uri-reference","sources":["bblocks://ogc.api.connected-systems.swecommon.abstract-simple-component"]},{"path":["axisID"],"description":"Specifies the reference axis (refer to CRS axisID). The reference frame URI should also be specified unless it is inherited from parent Vector","schema_type":"string","sources":["bblocks://ogc.api.connected-systems.swecommon.abstract-simple-component"]},{"path":["nilValues"],"description":"Defines reserved values with special meaning (e.g., missing, out-of-range, etc.)","sources":["bblocks://ogc.api.connected-systems.swecommon.abstract-simple-component","bblocks://ogc.api.connected-systems.swecommon.time-range"]},{"path":["constraint"],"sources":["bblocks://ogc.api.connected-systems.swecommon.abstract-simple-component","bblocks://ogc.api.connected-systems.swecommon.time-range"]},{"path":["value"],"description":"Inline value(s) for the component. This property is optional to enable structure to act as a schema for values provided separately (e.g., in a datastream)","schema_type":"array","sources":["bblocks://ogc.api.connected-systems.swecommon.abstract-simple-component","bblocks://ogc.api.connected-systems.swecommon.time-range"]},{"path":["referenceTime"],"description":"Specifies the origin of the temporal reference frame as an ISO8601 date (used to specify time after an epoch that is to say in a custom frame)","schema_type":"string","format":"date-time","sources":["bblocks://ogc.api.connected-systems.swecommon.time-range"]},{"path":["localFrame"],"description":"Temporal frame of reference whose origin is located by the value of this component","schema_type":"string","format":"uri","sources":["bblocks://ogc.api.connected-systems.swecommon.time-range"]},{"path":["uom"],"description":"Temporal unit of measure used to express the value of this data component","required":true,"sources":["bblocks://ogc.api.connected-systems.swecommon.time-range"]},{"path":["uom","label"],"description":"A human readable label for the unit","schema_type":"string","sources":["bblocks://ogc.api.connected-systems.swecommon.basic-types"]},{"path":["uom","symbol"],"description":"The preferred unit symbol to use when presenting the data in a UI (use the UCUM code instead if no symbol is provided)","schema_type":"string","sources":["bblocks://ogc.api.connected-systems.swecommon.basic-types"]},{"path":["uom","code"],"schema_type":"string","sources":["bblocks://ogc.api.connected-systems.swecommon.basic-types"]},{"path":["uom","href"],"schema_type":"string","format":"uri","sources":["bblocks://ogc.api.connected-systems.swecommon.basic-types"]},{"path":["constraint","type"],"const":"AllowedTimes","sources":["bblocks://ogc.api.connected-systems.swecommon.basic-types"]},{"path":["constraint","values"],"schema_type":"array","sources":["bblocks://ogc.api.connected-systems.swecommon.basic-types"]},{"path":["constraint","intervals"],"schema_type":"array","sources":["bblocks://ogc.api.connected-systems.swecommon.basic-types"]},{"path":["constraint","significantFigures"],"schema_type":"integer","sources":["bblocks://ogc.api.connected-systems.swecommon.basic-types"]},{"path":["nilValues","reason"],"description":"The reason for using the reserved value","required":true,"schema_type":"string","format":"uri","sources":["bblocks://ogc.api.connected-systems.swecommon.basic-types"]},{"path":["nilValues","value"],"description":"The reserved value itself","required":true,"sources":["bblocks://ogc.api.connected-systems.swecommon.basic-types"]}]}