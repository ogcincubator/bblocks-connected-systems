{"defs":{},"properties":[{"path":["id"],"description":"Local ID of the command","required":true,"schema_type":"string","read_only":true,"sources":["bblocks://ogc.api.connected-systems.part2.command"]},{"path":["controlstream@id"],"description":"Local ID of the control stream that the command is part of. This can be omitted when posting the command to a specific control stream URL.","required":true,"schema_type":"string","read_only":true,"sources":["bblocks://ogc.api.connected-systems.part2.command"]},{"path":["samplingFeature@id"],"description":"Local ID of the sampling feature that is the target of the command","schema_type":"string","sources":["bblocks://ogc.api.connected-systems.part2.command"]},{"path":["procedure@link"],"description":"Link to the procedure/method used to process the command","sources":["bblocks://ogc.api.connected-systems.part2.command"]},{"path":["procedure@link","href"],"description":"URL of target resource","required":true,"schema_type":"string","format":"uri","sources":["bblocks://ogc.api.connected-systems.common.link"]},{"path":["procedure@link","rel"],"description":"Link relation type","schema_type":"string","sources":["bblocks://ogc.api.connected-systems.common.link"]},{"path":["procedure@link","type"],"description":"Media type of target resource","schema_type":"string","sources":["bblocks://ogc.api.connected-systems.common.link"]},{"path":["procedure@link","hreflang"],"description":"Language tag of target resource (2-letter language code, followed by optional 2-letter region code)","schema_type":"string","sources":["bblocks://ogc.api.connected-systems.common.link"]},{"path":["procedure@link","title"],"description":"Title of target resource","schema_type":"string","sources":["bblocks://ogc.api.connected-systems.common.link"]},{"path":["procedure@link","uid"],"description":"Unique identifier of target resource","schema_type":"string","format":"uri","sources":["bblocks://ogc.api.connected-systems.common.link"]},{"path":["procedure@link","r