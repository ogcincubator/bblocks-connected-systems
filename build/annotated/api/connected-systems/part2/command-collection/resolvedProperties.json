{"defs":{"0":[{"path":["href"],"description":"URL of target resource","required":true,"schema_type":"string","format":"uri","sources":["bblocks://ogc.api.connected-systems.common.link"]},{"path":["hreflang"],"description":"Language tag of target resource (2-letter language code, followed by optional 2-letter region code)","schema_type":"string","sources":["bblocks://ogc.api.connected-systems.common.link"]},{"path":["if"],"description":"Interface used to access target resource (RFC 6690)","schema_type":"string","format":"uri","sources":["bblocks://ogc.api.connected-systems.common.link"]},{"path":["rel"],"description":"Link relation type","schema_type":"string","sources":["bblocks://ogc.api.connected-systems.common.link"]},{"path":["rt"],"description":"Semantic type of target resource (RFC 6690)","schema_type":"string","format":"uri","sources":["bblocks://ogc.api.connected-systems.common.link"]},{"path":["title"],"description":"Title of target resource","schema_type":"string","sources":["bblocks://ogc.api.connected-systems.common.link"]},{"path":["type"],"description":"Media type of target resource","schema_type":"string","sources":["bblocks://ogc.api.connected-systems.common.link"]},{"path":["uid"],"description":"Unique identifier of target resource","schema_type":"string","format":"uri","sources":["bblocks://ogc.api.connected-systems.common.link"]}]},"properties":[{"path":["items"],"required":true,"schema_type":"array","sources":["bblocks://ogc.api.connected-systems.part2.command-collection"]},{"path":["items","id"],"description":"Local ID of the command","required":true,"schema_type":"string","read_only":true,"sources":["bblocks://ogc.api.connected-systems.part2.command"]},{"path":["items","controlstream@id"],"description":"Local ID of the control stream that the command is part of. This can be omitted when posting the command to a specific control stream URL.","required":true,"schema_type":"string","read_only":true,"sources":["bblocks://ogc.api.connected-systems.p