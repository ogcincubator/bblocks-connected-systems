{"defs":{"0":[{"path":["href"],"description":"URL of target resource","required":true,"schema_type":"string","format":"uri","sources":["bblocks://ogc.api.connected-systems.common.link"]},{"path":["hreflang"],"description":"Language tag of target resource (2-letter language code, followed by optional 2-letter region code)","schema_type":"string","sources":["bblocks://ogc.api.connected-systems.common.link"]},{"path":["if"],"description":"Interface used to access target resource (RFC 6690)","schema_type":"string","format":"uri","sources":["bblocks://ogc.api.connected-systems.common.link"]},{"path":["rel"],"description":"Link relation type","schema_type":"string","sources":["bblocks://ogc.api.connected-systems.common.link"]},{"path":["rt"],"description":"Semantic type of target resource (RFC 6690)","schema_type":"string","format":"uri","sources":["bblocks://ogc.api.connected-systems.common.link"]},{"path":["title"],"description":"Title of target resource","schema_type":"string","sources":["bblocks://ogc.api.connected-systems.common.link"]},{"path":["type"],"description":"Media type of target resource","schema_type":"string","sources":["bblocks://ogc.api.connected-systems.common.link"]},{"path":["uid"],"description":"Unique identifier of target resource","schema_type":"string","format":"uri","sources":["bblocks://ogc.api.connected-systems.common.link"]}]},"properties":[{"path":["items"],"required":true,"schema_type":"array","sources":["bblocks://ogc.api.connected-systems.part2.observation-collection"]},{"path":["items","id"],"description":"Local ID of the observation","required":true,"schema_type":"string","read_only":true,"sources":["bblocks://ogc.api.connected-systems.part2.observation"]},{"path":["items","datastream@id"],"description":"Local ID of the datastream that the observation is part of","required":true,"schema_type":"string","read_only":true,"sources":["bblocks://ogc.api.connected-systems.part2.observation"]},{"path":["items","samplingFeature@id"],"description":"Local ID of the sampling feature that is the target of the observation","schema_type":"string","sources":["bblocks://ogc.api.connected-systems.part2.observation"]},{"path":["items","procedure@link"],"description":"Link to the procedure/method used to make the observation","sources":["bblocks://ogc.api.connected-systems.part2.observation"],"ref":"0"},{"path":["items","phenomenonTime"],"description":"Time at which the observation result is a valid estimate of the sampling feature property(ies). Defaults to the same value as `resultTime`.","sources":["bblocks://ogc.api.connected-systems.part2.observation"]},{"path":["items","resultTime"],"description":"Time at which the observation result was generated.","required":true,"sources":["bblocks://ogc.api.connected-systems.part2.observation"]},{"path":["items","parameters"],"description":"Parameters of the observation. Must be valid according to the parameters schema provided in the datastream metadata.","schema_type":"object","sources":["bblocks://ogc.api.connected-systems.part2.observation"]},{"path":["items","result"],"description":"Result of the observation. Must be valid according to the result schema provided in the datastream metadata.","sources":["bblocks://ogc.api.connected-systems.part2.observation"]},{"path":["items","result@link"],"description":"Link to external result data (e.g., large raster dataset served by a tiling service)","sources":["bblocks://ogc.api.connected-systems.part2.observation"],"ref":"0"},{"path":["links"],"description":"Links to related resources (including paging)","sources":["bblocks://ogc.api.connected-systems.part2.observation-collection"],"ref":"0"}]}