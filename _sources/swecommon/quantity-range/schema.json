{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Decimal pair for specifying a quantity range with a unit of measure",
  "type": "object",
  "allOf": [
    {
      "$ref": "bblocks://ogc.api.connected-systems.swecommon.abstract-simple-component"
    },
    {
      "properties": {
        "type": {
          "const": "QuantityRange"
        },
        "uom": {
          "description": "Unit of measure used to express the value of this data component",
          "$ref": "bblocks://ogc.api.connected-systems.swecommon.basic-types#UnitReference"
        },
        "constraint": {
          "$ref": "bblocks://ogc.api.connected-systems.swecommon.basic-types#AllowedValues"
        },
        "nilValues": {
          "$ref": "bblocks://ogc.api.connected-systems.swecommon.basic-types#NilValuesNumber"
        },
        "value": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "bblocks://ogc.api.connected-systems.swecommon.basic-types#NumberOrSpecial"
          }
        }
      },
      "required": [
        "type",
        "definition",
        "label",
        "uom"
      ]
    }
  ]
}
