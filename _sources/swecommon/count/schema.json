{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Scalar component with integer representation used for a discrete counting value",
  "type": "object",
  "allOf": [
    {
      "$ref": "bblocks://ogc.api.connected-systems.swecommon.abstract-simple-component"
    },
    {
      "properties": {
        "type": {
          "const": "Count"
        },
        "constraint": {
          "$ref": "bblocks://ogc.api.connected-systems.swecommon.basic-types#AllowedValues"
        },
        "nilValues": {
          "$ref": "bblocks://ogc.api.connected-systems.swecommon.basic-types#NilValuesInteger"
        },
        "value": {
          "type": "integer"
        }
      },
      "required": [
        "type",
        "definition",
        "label"
      ]
    }
  ]
}
