{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Scalar component used to represent a categorical value as a simple token identifying a term in a code space",
  "type": "object",
  "allOf": [
    {
      "$ref": "bblocks://ogc.api.connected-systems.swecommon.abstract-simple-component"
    },
    {
      "properties": {
        "type": {
          "const": "Category"
        },
        "codeSpace": {
          "description": "Name of the dictionary where the possible values for this component are listed and defined",
          "type": "string",
          "format": "uri"
        },
        "constraint": {
          "$ref": "bblocks://ogc.api.connected-systems.swecommon.basic-types#AllowedTokens"
        },
        "nilValues": {
          "$ref": "bblocks://ogc.api.connected-systems.swecommon.basic-types#NilValuesText"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "definition",
        "label"
      ]
    }
  ]
}
