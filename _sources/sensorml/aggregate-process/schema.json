{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "allOf": [
    {
      "$ref": "bblocks://ogc.api.connected-systems.sensorml.abstract-process"
    },
    {
      "properties": {
        "type": {
          "const": "AggregateProcess"
        },
        "components": {
          "description": "The list of sub-processes",
          "$ref": "#/$defs/ComponentList"
        },
        "connections": {
          "description": "The explicit definition of data links between outputs, inputs, and parameters of the components within an aggregate process.",
          "$ref": "#/$defs/ConnectionList"
        }
      }
    }
  ],
  "$defs": {
    "ComponentList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "bblocks://ogc.api.connected-systems.swecommon.basic-types#SoftNamedProperty"
          },
          {
            "oneOf": [
              {
                "$ref": "bblocks://ogc.api.connected-systems.sensorml.simple-process"
              },
              {
                "$ref": "bblocks://ogc.api.connected-systems.sensorml.aggregate-process"
              },
              {
                "$ref": "bblocks://ogc.api.connected-systems.sensorml.physical-component"
              },
              {
                "$ref": "bblocks://ogc.api.connected-systems.sensorml.physical-system"
              },
              {
                "$ref": "bblocks://ogc.api.connected-systems.common.link",
                "properties": {
                  "type": {
                    "const": "Link"
                  }
                }
              }
            ]
          }
        ]
      },
      "$anchor": "ComponentList"
    },
    "ConnectionList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "$ref": "bblocks://ogc.api.connected-systems.sensorml.common-defs#PathRef"
          },
          "destination": {
            "$ref": "bblocks://ogc.api.connected-systems.sensorml.common-defs#PathRef"
          }
        },
        "required": [
          "source",
          "destination"
        ]
      },
      "$anchor": "ConnectionList"
    }
  }
}
